<resources>
    <style name="Theme.FreckleTV.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0E0B16</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.FreckleTV</item>
    </style>
    <style name="Theme.FreckleTV" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0E0B16</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
